[Unit]
Description=gmrender-resurrect DLNA media renderer
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'i=0; until ip -4 addr show eth0 | grep -q "inet 192.168"; do i=$((i+1)); [ $i -gt 60 ] && break; sleep 2; done'
ExecStart=/usr/local/bin/gmediarender --logfile=stdout -I eth0 -f OneCloud-TV-45 -u <REPLACE-WITH-YOUR-UUID> --gstout-audiosink=alsasink --gstout-videopipe="videoscale method=nearest-neighbour add-borders=true ! video/x-raw,width=1280,height=720,pixel-aspect-ratio=1/1 ! queue max-size-buffers=5 max-size-time=300000000 ! fbdevsink max-lateness=200000000"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
